<div class="divider"></div>

<!-- FINAL CTA / FORM -->
<section id="cta">
  <div class="cta-glow"></div>
  <div class="container">
    <div class="cta-inner">
      <span class="section-tag">Get Started</span>
      <h2 class="section-title fade-in">Stop Letting Missed Calls Turn Into Lost Customers</h2>
      <p class="section-body fade-in">Fill this out and I'll reach out to show you exactly how this can work for your detailing business.</p>
    </div>
    <div class="form-card fade-in" style="max-width:640px; margin:40px auto 0;">
      <div id="formContent">
        <div class="form-row">
          <div class="form-group">
            <label>Your Name</label>
            <input type="text" placeholder="John Smith" id="fname">
          </div>
          <div class="form-group">
            <label>Business Name</label>
            <input type="text" placeholder="Elite Detail Co." id="fbiz">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Phone Number</label>
            <input type="tel" placeholder="(555) 000-0000" id="fphone">
          </div>
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" placeholder="you@yourbusiness.com" id="femail">
          </div>
        </div>
        <div class="form-group">
          <label>Average number of calls per week</label>
          <select id="fcalls">
            <option value="">Select a range...</option>
            <option value="1-5">1–5 calls/week</option>
            <option value="6-10">6–10 calls/week</option>
            <option value="11-20">11–20 calls/week</option>
            <option value="20+">20+ calls/week</option>
          </select>
        </div>
        <button class="form-submit" onclick="submitForm()">
          See If This Fits My Business →
        </button>
        <p class="form-privacy">🔒 No spam. No pressure. Just a quick conversation about your business.</p>
      </div>
      <div class="form-success" id="formSuccess">
        <div class="success-icon">✓</div>
        <h3>You're on the list!</h3>
        <p>Thanks — I'll reach out soon with next steps and show you exactly how this works for your detailing business.</p>
      </div>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="container">
    <p style="margin-bottom:8px; font-family:Syne; font-weight:700; font-size:16px;">Missed Call Rescue</p>
    <p>Built for car detailing businesses that want to recover more leads, automatically.</p>
    <p style="margin-top:12px;">© 2025 Missed Call Rescue. All rights reserved.</p>
  </div>
</footer>

<script>
  // Nav scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 40);
    document.getElementById('stickyCta').classList.toggle('visible', window.scrollY > 600);
  });

  // Mobile menu
  function openMobile() { document.getElementById('mobileMenu').classList.add('open'); }
  function closeMobile() { document.getElementById('mobileMenu').classList.remove('open'); }

  // Intersection observer for fade-ins
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.fade-in, .step, .feature-card').forEach(el => observer.observe(el));

  // Stagger feature cards
  document.querySelectorAll('.feature-card').forEach((card, i) => {
    card.style.transitionDelay = (i * 0.08) + 's';
  });
  document.querySelectorAll('.step').forEach((step, i) => {
    step.style.transitionDelay = (i * 0.1) + 's';
  });

  // FAQ
  function toggleFaq(el) {
    const item = el.parentElement;
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(f => f.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  }

  // ROI Calculator
  function updateCalc() {
    const calls = parseInt(document.getElementById('callsSlider').value);
    const job = parseInt(document.getElementById('jobSlider').value);
    const rate = parseInt(document.getElementById('rateSlider').value);
    
    document.getElementById('callsVal').textContent = calls;
    document.getElementById('jobVal').textContent = '$' + job;
    document.getElementById('rateVal').textContent = rate + '%';
    
    const weekly = Math.round(calls * (rate / 100) * job);
    const monthly = weekly * 4;
    const yearly = weekly * 52;
    
    document.getElementById('calcResult').textContent = '$' + weekly.toLocaleString();
    document.getElementById('calcMonth').textContent = '$' + monthly.toLocaleString();
    document.getElementById('calcYear').textContent = '$' + yearly.toLocaleString();
  }
  
  ['callsSlider', 'jobSlider', 'rateSlider'].forEach(id => {
    document.getElementById(id).addEventListener('input', updateCalc);
  });

  // ─── Form submission ──────────────────────────────────────────────────────────
  async function submitForm() {
    const name        = document.getElementById('fname').value.trim();
    const biz         = document.getElementById('fbiz').value.trim();
    const phone       = document.getElementById('fphone').value.trim();
    const email       = document.getElementById('femail').value.trim();
    const callsPerWeek = document.getElementById('fcalls').value;

    // Basic validation
    if (!name || !biz || !phone || !email) {
      showFormError('Please fill out all fields before submitting.');
      return;
    }
    if (!callsPerWeek) {
      showFormError('Please select your average number of calls per week.');
      return;
    }

    // Button loading state
    const btn = document.querySelector('.form-submit');
    btn.textContent = 'Sending...';
    btn.disabled = true;
    btn.style.opacity = '0.7';
    clearFormError();

    try {
      const response = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          businessName: biz,
          phone,
          email,
          callsPerWeek,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || 'Something went wrong. Please try again.');
      }

      // Success — show confirmation
      document.getElementById('formContent').style.display = 'none';
      document.getElementById('formSuccess').style.display = 'block';

    } catch (err) {
      // Reset button
      btn.textContent = 'See If This Fits My Business →';
      btn.disabled = false;
      btn.style.opacity = '1';
      showFormError(err.message || 'Something went wrong. Please try again.');
    }
  }

  function showFormError(msg) {
    let el = document.getElementById('formError');
    if (!el) {
      el = document.createElement('p');
      el.id = 'formError';
      el.style.cssText = 'color:#ff5a5a;font-size:13px;margin-top:12px;text-align:center;';
      document.querySelector('.form-submit').insertAdjacentElement('afterend', el);
    }
    el.textContent = '⚠ ' + msg;
  }

  function clearFormError() {
    const el = document.getElementById('formError');
    if (el) el.remove();
  }
</script>
</body>
</html>
